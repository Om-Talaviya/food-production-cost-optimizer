# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Security (REQUIRED in production, minimum 32 random characters)
JWT_SECRET=super_secret_jwt_key_replace_in_production_min32chars!

# Database Configuration (Offline-First Local MongoDB Community Server)
# Default URI connects to the local MongoDB service on port 27017 with zero internet access required.
MONGODB_URI=mongodb://127.0.0.1:27017/food_production_cost_optimizer

# Storage Engine Selection:
#   auto     - Connects to local MongoDB; safely falls back to server/data/store.json if MongoDB is down (Default)
#   mongodb  - Strictly enforces MongoDB persistence (startup fails if MongoDB is unreachable)
#   json     - Operates strictly on local JSON file store (server/data/store.json)
STORAGE_BACKEND=auto

# Fallback Behavior:
#   true  - If local MongoDB is unreachable, activates local JSON store with clear diagnostic warning (Default)
#   false - Disables JSON fallback; throws error if MongoDB cannot be reached
ALLOW_STORE_FALLBACK=true

# AI Advisor Configuration (Optional: If omitted, system seamlessly runs in intelligent offline heuristic mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration (Production only - restrict to your frontend origin)
# CORS_ORIGIN=https://your-frontend-domain.com
