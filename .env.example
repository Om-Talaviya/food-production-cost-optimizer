# Server Configuration
PORT=5000
NODE_ENV=development

# Authentication Security (REQUIRED in production)
JWT_SECRET=super_secret_jwt_key_replace_in_production_min32chars!

# Database Configuration: Uses local JSON file store (server/data/store.json)
# MongoDB is not currently used; MONGODB_URI is ignored if set.

# AI Advisor Configuration (Optional: If omitted, system seamlessly runs in intelligent offline demo mode)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration (Production only - restrict to your frontend origin)
# CORS_ORIGIN=https://your-frontend-domain.com
